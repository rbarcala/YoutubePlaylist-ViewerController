#!/bin/bash
# Wrapper ejecutable para YouTube Stream Controller
# Busca el entorno virtual adecuado y lanza la aplicación nativa

set -e

# Obtener ruta absoluta real de este script resolviendo enlaces simbólicos
TARGET="${BASH_SOURCE[0]}"
while [ -h "$TARGET" ]; do
    DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"
    TARGET="$(readlink "$TARGET")"
    [[ $TARGET != /* ]] && TARGET="$DIR/$TARGET"
done
SELF_DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"

# Detectar directorio base de la aplicación
if [ -f "$SELF_DIR/app.py" ]; then
    APP_DIR="$SELF_DIR"
elif [ -f "$SELF_DIR/../app.py" ]; then
    APP_DIR="$(cd -P "$SELF_DIR/.." >/dev/null 2>&1 && pwd)"
elif [ -d "/usr/share/youtube-stream-controller" ] && [ -f "/usr/share/youtube-stream-controller/app.py" ]; then
    APP_DIR="/usr/share/youtube-stream-controller"
else
    APP_DIR="$(cd -P "$SELF_DIR/.." >/dev/null 2>&1 && pwd)"
fi

cd "$APP_DIR"

# Verificar configuración inicial de cámara virtual para no pedir contraseña luego
if [ ! -f /etc/modules-load.d/obs-v4l2loopback.conf ]; then
    echo "Configurando entorno de cámara virtual por primera vez..."
    if [ -f "$APP_DIR/scripts/setup_v4l2.sh" ]; then
        if command -v pkexec >/dev/null 2>&1; then
            pkexec bash "$APP_DIR/scripts/setup_v4l2.sh" || echo "Aviso: Se canceló la configuración automática de la cámara."
        else
            sudo bash "$APP_DIR/scripts/setup_v4l2.sh" || echo "Aviso: Se canceló la configuración automática de la cámara."
        fi
    fi
fi

# Priorizar python del venv si existe, con fallback a python3 del sistema
if [ -x "$APP_DIR/venv/bin/python" ]; then
    PYTHON_EXEC="$APP_DIR/venv/bin/python"
elif [ -x "$APP_DIR/.venv/bin/python" ]; then
    PYTHON_EXEC="$APP_DIR/.venv/bin/python"
elif [ -x "$HOME/.local/share/youtube-stream-controller/venv/bin/python" ]; then
    PYTHON_EXEC="$HOME/.local/share/youtube-stream-controller/venv/bin/python"
else
    PYTHON_EXEC="python3"
fi

# Auto-instalar dependencias de sistema si faltan
echo "Comprobando dependencias del sistema (PyQt5, Flask, etc)..."
MISSING_APT=""
for pkg in python3-pyqt5 python3-pyqt5.qtwebengine python3-flask python3-requests yt-dlp; do
    if ! dpkg -s $pkg >/dev/null 2>&1; then
        MISSING_APT="$MISSING_APT $pkg"
    fi
done

if [ -n "$MISSING_APT" ]; then
    echo "Instalando paquetes faltantes en Ubuntu:$MISSING_APT"
    if command -v pkexec >/dev/null 2>&1; then
        pkexec env DISPLAY=$DISPLAY XAUTHORITY=$XAUTHORITY apt-get install -y $MISSING_APT || sudo apt-get install -y $MISSING_APT
    else
        sudo apt-get install -y $MISSING_APT
    fi
fi

# Auto-instalar dependencias de pip en el venv (rápido, silencioso)
if [ -f "$APP_DIR/requirements.txt" ]; then
    "$PYTHON_EXEC" -m pip install -q -r "$APP_DIR/requirements.txt" 2>/dev/null || true
fi

# Wrapper exec
exec "$PYTHON_EXEC" "$APP_DIR/app.py" "$@"
